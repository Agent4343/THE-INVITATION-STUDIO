# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PURCHASE_WEBHOOK_SECRET=
STRIPE_PRINT_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# AI suggestions
ANTHROPIC_API_KEY=

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
