# Public app URL (set this to your Railway public domain after first deploy)
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Public storefront links
NEXT_PUBLIC_ETSY_SHOP_URL=https://www.etsy.com/shop/your-shop
NEXT_PUBLIC_ETSY_PRIMARY_LISTING_URL=
ETSY_CHECKOUT_LISTING_URL=
ETSY_MESSAGE_SELLER_URL=

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
